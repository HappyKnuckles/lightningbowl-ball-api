      }
    },
    "/coverstocks": {
      "get": {
        "operationId": "listCoverstocks",
        "summary": "Coverstocks",
        "security": [],
        "tags": [
          "Catalog"
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Case-insensitive substring match on the name (and brand). Alias: `q`.",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Brand (exact, case-insensitive). Repeat the parameter for several values.",
            "schema": {
              "default": [],
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 200
              }
            },
            "style": "form",
            "explode": true
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order as `field` or `field,asc|desc`. Repeat for tie-breakers. Fields: coverstock_name, brand.",
            "schema": {
              "default": [],
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(coverstock_name|brand)(,(asc|desc|ASC|DESC))?$"
              }
            },
            "style": "form",
            "explode": true
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Zero-based page number. When `page` or `size` is given, the response is a page instead of an array.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "Page size (max 100, default 20). When `page` or `size` is given, the response is a page instead of an array.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A plain array, or a page when `page` or `size` is given. Sorted by name (and brand).",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Coverstock"
                      }
                    },
                    {
                      "$ref": "#/components/schemas/CoverstockPage"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (100 requests per minute per IP).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Catalog size and last sync",
        "security": [],
        "tags": [
          "Operations"
        ],
        "responses": {
          "200": {
            "description": "Status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (100 requests per minute per IP).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database not set up yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotInitialized"
                }
              }
            }
          }
        }
      }
    },
    "/cron/sync": {
      "get": {
        "operationId": "runSync",
        "summary": "Run the catalog sync",
        "security": [
          {
            "cronSecret": []
          }
        ],
        "tags": [
          "Operations"
        ],
        "description": "Called nightly by Vercel Cron. Applies pending migrations, then imports from bowwwl.com.",
        "responses": {
          "200": {
            "description": "Finished run (`success` or `partial`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncRun"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong secret.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Another run is in progress.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncSkipped"
                }
              }
            }
          },
          "500": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Every part of the run failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncRun"
                }
              }
            }
          }
        }
      }
    }
  },
