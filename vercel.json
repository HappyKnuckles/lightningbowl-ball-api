{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "17 1 * * *"
    }
  ],
  "functions": {
    "api/cron/sync.ts": {
      "maxDuration": 300,
      "includeFiles": "migrations/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/openapi.json",
      "destination": "/api/openapi"
    }
  ]
}
