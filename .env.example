# Neon pooled connection string (Project → Connection Details → "Pooled connection")
DATABASE_URL=postgres://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Random secret; Vercel Cron sends it as "Authorization: Bearer <secret>"
CRON_SECRET=

# Comma-separated CORS origins. Vercel preview deployments of the app are always allowed.
ALLOWED_ORIGINS=https://lightningbowl.de

# Optional: ball weights to sync (default 12,13,14,15,16)
# SYNC_WEIGHTS=12,13,14,15,16
